@{
    ViewData["Title"] = "Home Page";
}

<div class="row">
    <div class="col-lg-8 mx-auto text-center">
        <div class="mb-5">
            <i class="bi bi-mortarboard-fill text-primary" style="font-size: 4rem;"></i>
        </div>
        <h1 class="display-4 fw-bold mb-4">Student Service Request System</h1>
        <p class="lead text-muted mb-5">
            A simple and efficient system for students to submit service requests
            and for staff to manage them effectively.
        </p>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="d-flex gap-3 justify-content-center mb-5">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-person-plus me-2"></i>Register as Student
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg px-5">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </a>
            </div>
        }
        else
        {
            @if (User.IsInRole("Student"))
            {
                <a asp-controller="Student" asp-action="Dashboard" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-speedometer2 me-2"></i>Go to Dashboard
                </a>
            }
            else if (User.IsInRole("Staff"))
            {
                <a asp-controller="Staff" asp-action="Index" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-speedometer2 me-2"></i>Go to Staff Panel
                </a>
            }
        }
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-ui-checks text-primary mb-3" style="font-size: 2.5rem;"></i>
                <h5 class="card-title">Easy Submission</h5>
                <p class="card-text text-muted">Students can submit requests for ID cards, transcripts, and certificates with just a few clicks.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-eye text-primary mb-3" style="font-size: 2.5rem;"></i>
                <h5 class="card-title">Track Status</h5>
                <p class="card-text text-muted">Real-time status tracking - Pending, Processing, Completed, or Rejected.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-shield-lock text-primary mb-3" style="font-size: 2.5rem;"></i>
                <h5 class="card-title">Secure Access</h5>
                <p class="card-text text-muted">Role-based access control ensures only authorized staff can manage requests.</p>
            </div>
        </div>
    </div>
</div>