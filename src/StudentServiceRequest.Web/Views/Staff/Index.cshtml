@model StaffRequestsViewModel
@{
    ViewData["Title"] = "All Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-list-ul me-2"></i>All Service Requests</h2>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold small">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Search by name, email, description..." value="@Model.Search" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small">Status Filter</label>
                <select name="statusId" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var status in Model.Statuses)
                    {
                        var isSelected = Model.StatusId == status.Id;
                        <option value="@status.Id" selected="@isSelected">@status.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Requests != null && Model.Requests.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Updated</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.Requests)
                        {
                            <tr>
                                <td>
                                    <div>
                                        <strong>@request.StudentName</strong>
                                        <br />
                                        <small class="text-muted">@request.StudentEmail</small>
                                    </div>
                                </td>
                                <td>@request.RequestTypeName</td>
                                <td style="max-width: 300px;">@request.Description</td>
                                <td>
                                    <span class="badge bg-@request.StatusCssClass fs-6 px-3 py-2">
                                        @request.StatusName
                                    </span>
                                </td>
                                <td>@request.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (request.UpdatedAt.HasValue)
                                    {
                                        @request.UpdatedAt.Value.ToString("MMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil-square"></i> Manage
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer">
                    <nav aria-label="Pagination">
                        <ul class="pagination justify-content-center mb-0">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-statusId="@Model.StatusId">Previous</a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-statusId="@Model.StatusId">@i</a>
                                </li>
                            }
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-statusId="@Model.StatusId">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">No requests found</h5>
                <p class="text-muted">No service requests match your current filters.</p>
            </div>
        }
    </div>
</div>