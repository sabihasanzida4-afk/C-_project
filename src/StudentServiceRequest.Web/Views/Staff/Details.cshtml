@model UpdateStatusViewModel
@{
    ViewData["Title"] = "Manage Request";
    var request = ViewBag.Request as RequestDetailViewModel;
    if (request == null) { return; }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil-square me-2"></i>Manage Request</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to All Requests
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@request.RequestTypeName</h5>
                <span class="badge bg-@request.StatusCssClass fs-6 px-3 py-2">@request.StatusName</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Description</label>
                    <p class="mb-0">@request.Description</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Request Type Details</label>
                    <p class="mb-0 text-muted">@request.RequestTypeDescription</p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Update Status</h5>
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" asp-for="RequestId" />

                    <div class="mb-3">
                        <label asp-for="StatusId" class="form-label fw-semibold"></label>
                        <select asp-for="StatusId" asp-items="Model.Statuses" class="form-select">
                        </select>
                        <span asp-validation-for="StatusId" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-2"></i>Update Status
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-person me-2"></i>Student Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Name</label>
                    <p class="mb-0">@request.StudentName</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Email</label>
                    <p class="mb-0">@request.StudentEmail</p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Request Information</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold text-muted small">Request ID</label>
                        <p class="mb-0 font-monospace">#@request.Id</p>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold text-muted small">Type</label>
                        <p class="mb-0">@request.RequestTypeName</p>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold text-muted small">Submitted</label>
                        <p class="mb-0">@request.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold text-muted small">Last Updated</label>
                        <p class="mb-0">
                            @if (request.UpdatedAt.HasValue)
                            {
                                @request.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}