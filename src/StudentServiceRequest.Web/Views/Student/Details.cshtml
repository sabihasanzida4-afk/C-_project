@model RequestDetailViewModel
@{
    ViewData["Title"] = "Request Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-ticket-detailed me-2"></i>Request Details</h2>
    <a asp-action="MyRequests" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to My Requests
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Model.RequestTypeName</h5>
                <span class="badge bg-@Model.StatusCssClass fs-6 px-3 py-2">@Model.StatusName</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Description</label>
                    <p class="mb-0">@Model.Description</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Request Type Details</label>
                    <p class="mb-0 text-muted">@Model.RequestTypeDescription</p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Request Information</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Request ID</label>
                        <p class="mb-0 font-monospace">#@Model.Id</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Submitted On</label>
                        <p class="mb-0">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Last Updated</label>
                        <p class="mb-0">
                            @if (Model.UpdatedAt.HasValue)
                            {
                                @Model.UpdatedAt.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">Not updated</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Status</label>
                        <p class="mb-0"><span class="badge bg-@Model.StatusCssClass fs-6 px-3 py-2">@Model.StatusName</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-person me-2"></i>Student Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Name</label>
                    <p class="mb-0">@Model.StudentName</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">Email</label>
                    <p class="mb-0">@Model.StudentEmail</p>
                </div>
            </div>
        </div>
    </div>
</div>