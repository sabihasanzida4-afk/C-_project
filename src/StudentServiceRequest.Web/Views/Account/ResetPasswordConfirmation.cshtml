@{
    ViewData["Title"] = "Password Reset Complete";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-check-circle-fill me-2"></i>Password Reset Successful</h4>
            </div>
            <div class="card-body p-4 text-center">
                <i class="bi bi-shield-check text-success mb-3" style="font-size: 3rem;"></i>
                <h5 class="mb-3">Your password has been reset successfully.</h5>
                <p class="text-muted">You can now log in with your new password.</p>
                <a asp-action="Login" class="btn btn-primary">Login</a>
            </div>
        </div>
    </div>
</div>