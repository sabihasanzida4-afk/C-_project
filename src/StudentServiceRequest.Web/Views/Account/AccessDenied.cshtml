@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Access Denied</h4>
            </div>
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger mb-3" style="font-size: 3rem;"></i>
                <h5 class="mb-3">You don't have permission to access this page.</h5>
                <p class="text-muted">Please contact an administrator if you believe this is an error.</p>
                <div class="d-flex gap-2 justify-content-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go Home</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>