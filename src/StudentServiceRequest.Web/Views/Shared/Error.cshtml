@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Error</h4>
            </div>
            <div class="card-body text-center p-4">
                <i class="bi bi-bug-fill text-danger mb-3" style="font-size: 3rem;"></i>
                <h5 class="mb-3">An error occurred while processing your request.</h5>
                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small">
                        Request ID: <code>@Model.RequestId</code>
                    </p>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i>Go Home
                </a>
            </div>
        </div>
    </div>
</div>